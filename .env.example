# ============================================================
# Enterprise Domain LLM — Environment Variables Example
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- HuggingFace ---
# Your HuggingFace Hub token (read-access is enough for public models)
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model selection ---
# Default base model to fine-tune
BASE_MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct

# --- Paths (override defaults in configs/) ---
# WORKSPACE_ROOT=/Users/yourname/Documents/Sem3Projects/LLM Assingment 1/enterprise-domain-llm

# --- WandB (optional experiment tracking) ---
WANDB_API_KEY=
WANDB_PROJECT=enterprise-domain-llm
WANDB_ENTITY=

# --- Misc ---
# Set to 1 to disable HF progress bars in notebooks
HF_HUB_DISABLE_PROGRESS_BARS=0
# Offline mode (no network calls to HF Hub)
TRANSFORMERS_OFFLINE=0
